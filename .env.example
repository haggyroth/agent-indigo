# Copy this file to .env and fill in your values.
# .env is gitignored — never commit it.

# ── Emulator ──────────────────────────────────────────────────────────────────
# The agent drives libmgba in-process. Requires `brew install mgba` and `python -m game._mgba_build`.
# Absolute path to the LeafGreen .gba ROM (loaded directly).
ROM_PATH=~/mgba-http/Pokemon_LeafGreen.gba

# Watch the agent play in a live window (native backend; requires pygame).
SHOW_WINDOW=false
VIEWER_SCALE=3      # 240x160 * scale -> window size (3 = 720x480)
VIEWER_FPS=60       # playback cap; 0 = uncapped (full emulator speed)

# ── LLM endpoint (local LM Studio OR any OpenAI-compatible cloud) ─────────────
# Local (default): leave these as-is and run LM Studio on port 1234.
LLM_BASE_URL=http://localhost:1234/v1
LLM_API_KEY=lm-studio
# Cloud models — point at any OpenAI-compatible endpoint and set your key:
#   OpenAI:      LLM_BASE_URL=https://api.openai.com/v1        LLM_API_KEY=sk-...
#   OpenRouter:  LLM_BASE_URL=https://openrouter.ai/api/v1     LLM_API_KEY=sk-or-...
#   (OpenRouter proxies Claude/Gemini/etc. via the OpenAI API shape)
#   Ollama (local or :cloud models; `ollama signin` for cloud):
#     LLM_BASE_URL=http://localhost:11434/v1   LLM_API_KEY=ollama   MODEL_NAME=gemma4:31b-cloud
# LM_STUDIO_BASE is still honoured as a fallback for LLM_BASE_URL.

# ── Model ─────────────────────────────────────────────────────────────────────
# The model id for your endpoint. Local: the name shown in LM Studio. Cloud: the
# provider's model id, e.g. gpt-4o, anthropic/claude-3.5-sonnet (OpenRouter).
#   qwen/qwen3-14b                  (Qwen3 — set ENABLE_THINKING=true)
#   qwen/qwen2.5-14b-instruct       (Qwen2.5 — set ENABLE_THINKING=false)
MODEL_NAME=qwen/qwen2.5-14b-instruct

# ── LLM sampling ──────────────────────────────────────────────────────────────
TEMPERATURE=0.6
# MAX_TOKENS caps the response (it doesn't force long output — the model stops
# when done). prompt + MAX_TOKENS must fit the model's *loaded* context window,
# or every call fails with "Context size exceeded". Reasoning models want more
# headroom (4096–8192) so the tool call isn't truncated; small-context builds
# need less. Check LM Studio's loaded context length.
MAX_TOKENS=4096

# Set to true only for reasoning models that expose reasoning_content/<think>.
ENABLE_THINKING=false

# ── Run control ───────────────────────────────────────────────────────────────
# USE_VISION: attach the live screenshot to the model. Set false for text-only
# models, or models with unstable vision (some crash/overflow on images).
USE_VISION=true
# START_FROM_SAVE: load a battery .sav and "Continue" into gameplay at startup
# (drives through title -> Continue -> skips the quest-log recap). Empty = boot
# the ROM as-is.
# START_FROM_SAVE=~/mgba-http/Pokemon_LeafGreen.sav
# START_FROM_STATE: load an mGBA save STATE (.ss*) directly — instant, no title/
# Continue/recap. Takes precedence over START_FROM_SAVE. Good for testing from a
# fixed spot, e.g. the Pallet Town exterior state generated in saves/.
# START_FROM_STATE=saves/pallet_exterior.ss1
# MAX_STEPS: stop after N decision steps (0 = run until interrupted).
MAX_STEPS=0

# ── Spend controls (important for cloud endpoints; 0 = unlimited) ─────────────
# The loop is otherwise unbounded and issues up to 6 completions per step, each
# with a screenshot + history — free against local LM Studio, real money against
# OpenAI/OpenRouter. These stop the run cleanly (like MAX_STEPS) once hit; the
# end-of-run line reports llm_calls and token totals either way. A startup
# warning fires if LLM_BASE_URL is non-local AND none of MAX_STEPS/MAX_LLM_CALLS/
# TOKEN_BUDGET is set.
# MAX_LLM_CALLS: stop after this many chat-completion API calls.
MAX_LLM_CALLS=0
# TOKEN_BUDGET: stop once cumulative prompt+completion tokens reach this.
TOKEN_BUDGET=0

# ── Paths ─────────────────────────────────────────────────────────────────────
# Where the agent writes its screenshot each tick.
# Defaults to the OS temp directory (e.g. /tmp/mgba_agent_frame.png on
# macOS/Linux, %TEMP%\mgba_agent_frame.png on Windows).
# Override only if needed:
# SCREENSHOT_PATH=/tmp/mgba_agent_frame.png        # macOS / Linux
# SCREENSHOT_PATH=C:\mgba\agent_frame.png          # Windows


# New game (quest('new_game'), with START_NEW_GAME=true): what to pick. Blank = bulbasaur / RED / BLUE. Options typed in the quest call itself override these.
# STARTER=squirtle              # bulbasaur | charmander | squirtle
# PLAYER_NAME=KYLE              # up to 7 letters (A-Z)
# RIVAL_NAME=GARY               # up to 7 letters (A-Z)

# Checkpoints: the agent saves an emulator state every CHECKPOINT_EVERY ticks (and per badge) under
# logs/runs/<ts>/checkpoints/. RESUME=latest (or a path to a .ss1) continues a cancelled/stuck run.
# CHECKPOINT_EVERY=20
# RESUME=latest

# Hold B while walking outdoors once the Running Shoes are owned (twice the speed). false = always walk.
# USE_RUNNING_SHOES=true

# Optional rule: raise the Elite Four's recommended levels after every loss in the League (the BASE levels — best Pokémon L54, five at L46+ — are always a wall).
#   LEAGUE_LOSS_RULE=advise  after a loss, quest('elite_four') tells the model once per loss that the bar went up and training is encouraged, then lets its next call go ahead (default)
#   LEAGUE_LOSS_RULE=wall    the raised levels are refused on every call too
#   LEAGUE_LOSS_RULE=off     no escalation
# LEAGUE_LOSS_RULE=advise
# LEAGUE_LOSS_BUMP=2         levels added to the best-Pokémon level and the depth level per loss

# LLM_RETRIES: a chat-completion call is retried through connection resets / timeouts / rate limits / 5xx with an exponential backoff (2, 4, 8 … 60 s) before it counts against the run's
# error budget. 8 (default) waits out about four minutes of trouble; 0 = no retries.
# LLM_RETRIES=8
